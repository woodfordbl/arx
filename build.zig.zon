.{
    .name = .arx,
    .version = "0.0.0",
    .fingerprint = 0xf5839a7f1adde18d, // Changing this has security and trust implications.
    // arx builds with exactly this Zig release (build.zig refuses any
    // other); CI and the Makefile install the same one.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "vendor/libyaml",
    },
}
