#!/usr/bin/env python3
"""after_tool: when a tool fails, adds a reminder to its result.

stdin:  {"call": {"id", "name", "args"}, "result": "...", "is_error": true|false,
         "point": ..., "session": ..., "turn": ...}
stdout: nothing, or {"note": "..."} (appended to the result the model sees).
"""
import json
import sys

event = json.load(sys.stdin)
if event.get("is_error"):
    print(json.dumps({"note": "The tool failed. Read the full output file "
                              "named above before you retry."}))
