#!/bin/sh
# op-key: an example credential program. It reads the API key that the
# 1Password secret reference in $ARX_OP_REF names, and prints it as
# {"api_key": "..."}. arx keeps the key in memory for the session and
# writes it only to the 0600 header file of each call, so the key is never
# in an environment variable, a config file or a process listing.
set -u

ref=${ARX_OP_REF:-}
if [ -z "$ref" ]; then
  echo "op-key: set ARX_OP_REF to a 1Password secret reference," \
    "such as op://Private/OpenRouter/credential" >&2
  exit 1
fi
# op prints its own reason on stderr, and arx shows it.
key=$(op read --no-newline "$ref") || exit 1
case $key in
  "" | *[\"\\]* | *'
'*)
    echo "op-key: $ref is empty or has characters a header cannot carry" >&2
    exit 1
    ;;
esac
printf '{"api_key": "%s"}\n' "$key"
