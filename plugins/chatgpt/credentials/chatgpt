#!/usr/bin/env python3
"""chatgpt: the credential program of the chatgpt plugin.

arx runs it before model calls (see docs/plugins/credentials.md). It prints
the bearer header for the signed-in ChatGPT account, refreshing the access
token first when it is about to expire or the endpoint rejected it. Exit 75
asks arx to try again later (the network); exit 1 stops the run, with the
reason on stderr.
"""
import json
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                "..", "lib"))
import chatgpt_auth as auth  # noqa: E402


def main():
    """Prints the credential value as JSON; returns the exit code."""
    try:
        request = json.load(sys.stdin)
    except ValueError:
        request = {}
    try:
        value = auth.credential(request.get("reason", "start"))
    except auth.TryLater as e:
        print("chatgpt: %s" % e, file=sys.stderr)
        return 75
    except auth.AuthError as e:
        print("chatgpt: %s" % e, file=sys.stderr)
        return 1
    print(json.dumps(value))
    return 0


if __name__ == "__main__":
    sys.exit(main())
