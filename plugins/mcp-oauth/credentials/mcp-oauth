#!/usr/bin/env python3
"""mcp-oauth: the credential program of the mcp-oauth plugin.

arx's HTTP bridge runs it for a server with `credential: mcp-oauth` (see
docs/plugins/credentials.md). It prints the bearer header of the signed-in
account, refreshing the access token first when it is about to expire or
the server rejected it. It never opens a browser. Exit 75 asks arx to try
again later (the network); exit 1 stops the request, and stderr says what
to run.
"""
import json
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                "..", "lib"))
import mcp_oauth as oauth  # noqa: E402


def main():
    """Prints the credential value as JSON; returns the exit code."""
    try:
        request = json.load(sys.stdin)
    except ValueError:
        request = {}
    try:
        value = oauth.credential(request if isinstance(request, dict) else {})
    except oauth.TryLater as e:
        print("mcp-oauth: %s" % e, file=sys.stderr)
        return 75
    except oauth.AuthError as e:
        print("mcp-oauth: %s" % e, file=sys.stderr)
        return 1
    print(json.dumps(value))
    return 0


if __name__ == "__main__":
    sys.exit(main())
