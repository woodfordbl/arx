#!/usr/bin/env bash
# arx-setup: set your provider, API key and default model (run this first)
#
# On a terminal, the first run is a wizard: provider, key, model, kit and
# PATH, one question each; nothing is saved until the end. Once a model is
# set, `arx setup` opens a settings menu instead. Flags answer questions,
# and the terminal asks the rest; without a terminal (a pipe, CI,
# ARX_UI=off), it asks nothing and uses the flags and defaults, as before.
#
# The key is checked against the endpoint, then saved in the macOS
# Keychain (service "arx"), or in a 0600 credentials file elsewhere. An
# environment variable with the same name always wins over the saved key.
# The defaults go to config.yaml in the arx config folder; any project's
# agent.yaml overrides them. The steps live in lib/setup-steps.sh, the
# save in lib/setup-save.sh and the menu in lib/setup-menu.sh.
set -u

usage() {
  cat <<'EOF'
usage: arx setup [STEP] [options]
  STEP              run one step: provider, key, model, kit, plugins or path
  --provider NAME   vercel (default), openrouter, openai, chatgpt, ollama or
                    custom
  --base-url URL    endpoint for --provider custom
  --key-env NAME    the variable the key is saved under
  --model ID        default model (else you pick one)
  --key-stdin       read the key from stdin instead of asking
  --kit NAME|none   make NAME your default kit, or have none
  --add-to-path     add arx's bin folder to your shell's startup file
  --no-test         skip the test call at the end
  --wizard          ask every question, even when arx is set up
  --if-needed       do nothing (one line, exit 0) when a model is set
On a terminal, flags answer questions and arx asks the rest; without one,
arx asks nothing. Esc goes back a step; Ctrl-C quits and changes nothing.
EOF
}

arx=${ARX_BIN:-arx}
lib=$(dirname "$0")/lib  # ui.sh and the setup steps, next to this file
f_provider="" f_base_url="" f_key_env="" f_model="" key_stdin=0 run_test=1
f_kit="" add_path=0 wizard=0 if_needed=0 step="" flags=0
while [ $# -gt 0 ]; do
  case "$1" in
    --provider | --base-url | --key-env | --model | --kit)
      [ $# -gt 1 ] || { echo "arx setup: $1 needs a value" >&2; usage >&2; exit 2; } ;;
  esac
  case "$1" in
    --provider) f_provider=$2; shift 2 ;;
    --base-url) f_base_url=$2; shift 2 ;;
    --key-env) f_key_env=$2; shift 2 ;;
    --model) f_model=$2; shift 2 ;;
    --kit) f_kit=$2; shift 2 ;;
    --key-stdin) key_stdin=1; shift ;;
    --no-test) run_test=0; shift ;;
    --add-to-path) add_path=1; shift ;;
    --wizard) wizard=1; shift ;;
    --if-needed) if_needed=1; flags=$((flags - 1)); shift ;;
    -h | --help) usage; exit 0 ;;
    provider | key | model | kit | plugins | path)
      [ -z "$step" ] || { usage >&2; exit 2; }
      step=$1 flags=$((flags - 1)); shift ;;
    *) echo "arx setup: unknown option $1" >&2; usage >&2; exit 2 ;;
  esac
  flags=$((flags + 1))
done

# The same lookup as ConfigDir() in arx.
if [ -n "${ARX_CONFIG_DIR:-}" ]; then
  config_dir=$ARX_CONFIG_DIR
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
  config_dir=$XDG_CONFIG_HOME/arx
else
  config_dir=$HOME/.config/arx
fi
config=$config_dir/config.yaml

for file in "$lib/ui.sh" "$lib/setup-steps.sh" "$lib/setup-save.sh" "$lib/setup-menu.sh"; do
  [ -f "$file" ] || { echo "arx setup: $file is missing; reinstall arx" >&2; exit 1; }
done
UI_NAME="arx setup"
. "$lib/ui.sh"
. "$lib/setup-steps.sh"
. "$lib/setup-save.sh"
. "$lib/setup-menu.sh"
# --key-stdin means stdin is the key, so nothing is asked (as before).
[ "$key_stdin" -eq 0 ] || [ -n "${ARX_UI:-}" ] || UI_MODE=off

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
# What the steps choose; save_all writes it.
provider="" base_url="" key_env="" key="" key_how="" model="" models="" kit=""
path_how="" bindir="" saved=""
read_current
if [ "$key_stdin" -eq 1 ]; then key=$(cat) key_how=stdin; fi

if [ "$if_needed" -eq 1 ] && [ -n "$cur_model" ]; then
  echo "arx is already set up (model $cur_model). Change it with \`arx setup\`."
  exit 0
fi

# Runs the steps in order. Esc (4) goes back to the last step that asked
# something; Esc on the first one, or Ctrl-C, cancels.
run_steps() {
  local i=1 dir=1 code n=$#
  while [ "$i" -ge 1 ] && [ "$i" -le "$n" ]; do
    "step_${!i}"
    code=$?
    case "$code" in
      0) dir=1 ;;
      5) ;;  # skipped: keep going the same way
      4) dir=-1 ;;
      *) ui_stop "$code"; exit "$code" ;;
    esac
    i=$((i + dir))
  done
  [ "$i" -gt "$n" ] || return 4
}

# The first run on a terminal (or --wizard, or flags with a model set).
wizard() {
  if [ "$UI_MODE" = menu ]; then
    ui__say "Set up arx. Esc goes back, Ctrl-C quits; nothing is saved until the end."
  else
    ui__say "Set up arx. Ctrl-C quits; nothing is saved until the end."
  fi
  run_steps provider key model kit path || ui_stop 130
  save_all
  step_test
  cat <<'EOF'

  arx            talk to the agent in this folder
  arx init       start a harness here
  arx setup      change any of this later
EOF
}

# Without a terminal: the flags and the defaults, with today's messages.
unattended() {
  local s
  for s in provider key model kit path; do
    "step_$s"
    case $? in 0 | 5) ;; *) exit 2 ;; esac
  done
  save_all
  step_test
  cat <<'EOF'

Done. Next:
  arx                 talk to the agent here
  arx init            start a harness in this folder (tools, hooks, prompts)
  arx doctor          check everything
EOF
}

if [ -n "$step" ]; then
  run_step "$step"
  code=$?
  [ "$code" -ne 4 ] || code=0
  ui_stop "$code"
  exit "$code"
elif [ "$UI_MODE" = off ]; then
  unattended
elif [ -n "$cur_model" ] && [ "$wizard" -eq 0 ] && [ "$flags" -eq 0 ]; then
  settings_menu
else
  wizard
fi
