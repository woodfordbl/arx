#!/usr/bin/env bash
# arx-setup: set your provider, API key and default model (run this first)
#
# Like fx setup: the key is checked against the endpoint, then saved in the
# macOS Keychain (service "arx"), or in a 0600 credentials file elsewhere.
# An environment variable with the same name always wins over the saved key.
# The defaults go to config.yaml in the arx config folder; any project's
# agent.yaml overrides them.
set -u

usage() {
  cat <<'EOF'
usage: arx setup [options]
  --provider NAME   vercel (default), openrouter, openai, ollama or custom
  --base-url URL    endpoint for --provider custom
  --key-env NAME    the variable the key is saved under
  --model ID        default model (else you pick one)
  --key-stdin       read the key from stdin instead of asking
  --no-test         skip the test call at the end
EOF
}

arx=${ARX_BIN:-arx}
provider="" base_url="" key_env="" model="" key_stdin=0 run_test=1
while [ $# -gt 0 ]; do
  case "$1" in
    --provider) provider=$2; shift 2 ;;
    --base-url) base_url=$2; shift 2 ;;
    --key-env) key_env=$2; shift 2 ;;
    --model) model=$2; shift 2 ;;
    --key-stdin) key_stdin=1; shift ;;
    --no-test) run_test=0; shift ;;
    -h | --help) usage; exit 0 ;;
    *) echo "arx setup: unknown option $1" >&2; usage >&2; exit 2 ;;
  esac
done

# The same lookup as ConfigDir() in arx.
if [ -n "${ARX_CONFIG_DIR:-}" ]; then
  config_dir=$ARX_CONFIG_DIR
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
  config_dir=$XDG_CONFIG_HOME/arx
else
  config_dir=$HOME/.config/arx
fi
mkdir -p "$config_dir"
interactive=0
[ -t 0 ] && [ "$key_stdin" -eq 0 ] && interactive=1

# Asks a question with a default answer (non-interactive: the default).
ask() {
  local answer=""
  if [ "$interactive" -eq 1 ]; then read -r -p "$1 [$2]: " answer; fi
  echo "${answer:-$2}"
}

if [ -z "$provider" ]; then
  if [ "$interactive" -eq 1 ]; then
    echo "Which provider? Any OpenAI-compatible endpoint works."
    echo "  1) Vercel AI Gateway   2) OpenRouter   3) OpenAI"
    echo "  4) Ollama (local)      5) Other OpenAI-compatible URL"
  fi
  case "$(ask "Provider" 1)" in
    1 | vercel) provider=vercel ;;
    2 | openrouter) provider=openrouter ;;
    3 | openai) provider=openai ;;
    4 | ollama) provider=ollama ;;
    *) provider=custom ;;
  esac
fi
case "$provider" in
  vercel) url=https://ai-gateway.vercel.sh/v1 env=AI_GATEWAY_API_KEY def=anthropic/claude-haiku-5.5 ;;
  openrouter) url=https://openrouter.ai/api/v1 env=OPENROUTER_API_KEY def="" ;;
  openai) url=https://api.openai.com/v1 env=OPENAI_API_KEY def=gpt-5-mini ;;
  ollama) url=http://localhost:11434/v1 env="" def="" ;;
  custom) url="" env=ARX_API_KEY def="" ;;
  *) echo "arx setup: unknown provider $provider" >&2; exit 2 ;;
esac
base_url=${base_url:-$url}
[ -n "$base_url" ] || base_url=$(ask "Base URL (ending in /v1)" "http://localhost:8000/v1")
key_env=${key_env:-$env}

# The keys that choose plugins (kit:, plugins:, enable:, disable:), which
# `arx kit add --default` and `arx plugin enable --global` write: kept.
keep=$(awk '/^(kit|plugins|enable|disable):/ {k = 1; print; next}
  k && /^[ \t-]/ {print; next} {k = 0}' "$config_dir/config.yaml" 2>/dev/null)

# Writes config.yaml; the previous one is kept as config.yaml.bak.
write_config() {
  [ -f "$config_dir/config.yaml" ] && cp "$config_dir/config.yaml" "$config_dir/config.yaml.bak"
  {
    echo "# Written by \`arx setup\` on $(date +%Y-%m-%d). A project's agent.yaml"
    echo "# overrides any key here; rerun \`arx setup\` to change them."
    echo "model: \"$1\""
    if [ -n "$key_env" ]; then
      echo "endpoint: {base_url: \"$base_url\", api_key_env: $key_env}"
    else
      echo "endpoint: {base_url: \"$base_url\"}"
    fi
    if [ -n "${2:-}" ]; then echo "$2"; fi
    if [ -n "$keep" ]; then echo "$keep"; fi
  } >"$config_dir/config.yaml"
}
write_config "${model:-$def}"

# Saves the key: macOS Keychain, else the 0600 credentials file. Neither
# path puts the key on a command line, so it never shows in a process list.
save_key() {
  if [ "$(uname)" = Darwin ] && [ -z "${ARX_DISABLE_KEYCHAIN:-}" ]; then
    if printf 'add-generic-password -U -s arx -a %s -w "%s"\n' "$key_env" "$1" |
      security -i >/dev/null 2>&1; then
      echo "Saved the key in your macOS Keychain (service arx, account $key_env)."
      return
    fi
  fi
  local file=$config_dir/credentials
  (umask 077 && touch "$file")
  grep -v "^$key_env=" "$file" >"$file.tmp" 2>/dev/null
  echo "$key_env=$1" >>"$file.tmp"
  chmod 600 "$file.tmp" && mv "$file.tmp" "$file"
  echo "Saved the key in $file (readable only by you)."
}

if [ -n "$key_env" ]; then
  key=""
  if [ "$key_stdin" -eq 1 ]; then
    key=$(cat)
  elif [ -n "$(printenv "$key_env")" ] &&
    [ "$(ask "Use \$$key_env from your environment? (y/n)" y)" = y ]; then
    key=$(printenv "$key_env")
  fi
  while :; do
    if [ -z "$key" ] && [ "$interactive" -eq 1 ]; then
      read -r -s -p "Paste your API key for $base_url (hidden): " key
      echo
    fi
    [ -n "$key" ] || { echo "arx setup: no key given" >&2; exit 2; }
    (export "$key_env=$key" && "$arx" request /models >/dev/null 2>&1)
    code=$?
    if [ "$code" -eq 0 ]; then echo "The key works."; break; fi
    if [ "$code" -eq 4 ] && [ "$interactive" -eq 1 ]; then
      echo "The endpoint rejected that key; try again."
      key=""
      continue
    fi
    echo "arx setup: could not check the key (arx request exited $code); saving it anyway." >&2
    break
  done
  save_key "$key"
  export "$key_env=$key"
fi

# Picks the default model, with context size and prices when the endpoint
# lists them.
models=$("$arx" request /models 2>/dev/null)
if [ -z "$model" ]; then
  if [ "$interactive" -eq 1 ] && [ -n "$models" ]; then
    echo "Some models from $base_url (see all with \`arx models\`):"
    printf '%s' "$models" | jq -r '.data[].id' 2>/dev/null |
      grep -E "${def:-.}|haiku|sonnet|gpt-5-mini|gemini-3-flash|qwen|llama" |
      head -8 | sed 's/^/  /'
  fi
  first=$(printf '%s' "$models" | jq -r '.data[0].id // empty' 2>/dev/null)
  model=$(ask "Default model" "${def:-$first}")
fi
extra=$(printf '%s' "$models" | jq -r --arg m "$model" '
  def per_million: tonumber * 1e9 | round / 1000;
  .data[]? | select(.id == $m) |
  [ (if .context_window then "context_window: \(.context_window)" else empty end),
    (if .pricing.input then "prices: {input: \(.pricing.input | per_million), output: \(.pricing.output | per_million)}" else empty end)
  ] | join("\n")' 2>/dev/null)
write_config "$model" "$extra"
echo "Wrote $config_dir/config.yaml (model $model)."

# arx has no tools of its own: bash and edit come from the shell plugin,
# which ships next to these commands. A link keeps it at the version of arx
# after `arx update`. Without a copy here, it comes from the arx repo.
shell_plugin=$config_dir/plugins/shell
if [ ! -e "$shell_plugin" ] && [ ! -L "$shell_plugin" ]; then
  shell_ref=shell link=""
  for dir in "${ARX_LIBEXEC:-.}/plugins/shell" "${ARX_LIBEXEC:-.}/../plugins/shell"; do
    if [ -n "${ARX_LIBEXEC:-}" ] && [ -f "$dir/plugin.yaml" ]; then shell_ref=$dir link=--link; break; fi
  done
  if "$arx" plugin add $link "$shell_ref" --yes >/dev/null; then
    echo "Turned on the shell plugin: the agent's bash and edit tools."
  else
    echo "arx setup: could not add the shell plugin, so the agent has no tools; try \`arx plugin add shell\`." >&2
  fi
fi

if [ "$run_test" -eq 1 ]; then
  tmp=$(mktemp -d)
  echo "Test call..."
  reply=$(cd "$tmp" && "$arx" -p "Reply with exactly: arx is ready" --quiet --cap usd=0.02 --cap turns=2 2>&1)
  code=$?
  rm -rf "$tmp"
  if [ "$code" -eq 0 ]; then echo "  $reply"; else echo "  The test call failed (exit $code): $reply"; fi
fi
cat <<'EOF'

Done. Next:
  arx                 talk to the agent here
  arx init            start a harness in this folder (tools, hooks, prompts)
  arx doctor          check everything
EOF
